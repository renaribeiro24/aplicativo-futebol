# Dedicated confirmed A/B/C accounts only. Configure values in secrets or an ignored work/ file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
TEST_USER_C_EMAIL=
TEST_USER_C_PASSWORD=
# Explicit owner attestation. Set to 1 only for exclusive synthetic accounts and authorized fixtures.
TEST_ACCOUNTS_ARE_SYNTHETIC=
TEST_ALLOW_CREATE_AUDIT_FIXTURES=
# No service_role/admin credentials are accepted by the HTTP runner.
